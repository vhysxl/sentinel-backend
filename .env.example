PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://neondb_owner:password@ep-fragrant-field-azdx2gef-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# FastAPI analysis service. Findings are relayed through this API, never called
# from the browser — the agent server has no authentication of its own, so in
# production it must sit somewhere the public internet cannot reach.
AGENT_SERVER_URL=http://127.0.0.1:8000

# Shared secret for the agent server handshake, sent as the X-Internal-Key
# header. Must match INTERNAL_API_KEY in sentinel-agent-server exactly, or every
# findings call comes back 503 with a "key was rejected" line in the logs.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVER_KEY=
