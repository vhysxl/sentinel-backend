    {
      "name": "Vendors",
      "description": "Endpoints to manage vendors.",
      "item": [
        {
          "name": "List Vendors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ]
            }
          }
        },
        {
          "name": "Create Vendor",
