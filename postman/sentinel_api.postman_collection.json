    {
      "name": "Guards",
      "description": "Cases the API must refuse. A green run here means the refusals still work — treat a failure as a security regression, not a broken test.",
      "item": [
        {
          "name": "Login — unknown email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('generic message', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid credentials');",
                  "});",
                  "pm.collectionVariables.set('probeUnknownEmail', pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@company.com\",\n  \"password\": \"whateverpass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login — wrong password (must match the previous message)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "",
                  "// The whole point: an outsider must not be able to tell an unknown",
                  "// email apart from a wrong password, or they could map the team.",
                  "const previous = pm.collectionVariables.get('probeUnknownEmail');",
                  "pm.test('identical to the unknown-email response', () => {",
                  "  pm.expect(pm.response.json().message).to.eql(previous);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{seedEmail}}\",\n  \"password\": \"definitelyWrong\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run this straight after the unknown-email request — it compares against the message that one captured."
          }
        },
        {
          "name": "Users — non-admin is forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('leaks no user data', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Needs `memberAccessToken`: log in as the created member first, then copy their access token into that variable.\n\nHiding the menu in the UI is not the protection — this is."
          }
        },
        {
          "name": "Users — cannot deactivate yourself",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('explains why', () => {",
                  "  pm.expect(pm.response.json().message).to.include('your own account');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{currentUserId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{currentUserId}}",
                "status"
              ]
            },
            "description": "Guards against the last Lead locking themselves out. Only the seed script can grant admin back."
          }
        },
        {
          "name": "Auth — garbage bearer token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not.a.real.token",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Errors — empty body returns field errors, not internals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('field errors are clean { field, message }', () => {",
                  "  body.errors.forEach(e => {",
                  "    pm.expect(e).to.have.property('field');",
                  "    pm.expect(e).to.have.property('message');",
                  "    pm.expect(e).to.not.have.property('code');",
                  "  });",
                  "});",
                  "pm.test('no stack trace anywhere', () => {",
                  "  const raw = pm.response.text();",
                  "  ['node_modules', 'at Object', 'stack', 'ECONNREFUSED'].forEach(marker => {",
                  "    pm.expect(raw, `response leaked \"${marker}\"`).to.not.include(marker);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Errors — malformed JSON is masked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('does not echo the payload back', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('bad json');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{bad json"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "body-parser quotes the raw payload in its own message, so that error is masked like any other."
          }
        },
