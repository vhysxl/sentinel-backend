    {
      "name": "Auth",
      "description": "Sign-in, session, and password management. Password login and Google login resolve to the same account by email.",
      "item": [
        {
          "name": "Login (password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('returns both tokens', () => {",
                  "  pm.expect(body.data.tokens.accessToken).to.be.a('string');",
                  "  pm.expect(body.data.tokens.refreshToken).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('never leaks the password hash', () => {",
                  "  pm.expect(body.data.user).to.not.have.property('passwordHash');",
                  "});",
                  "",
                  "pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "pm.collectionVariables.set('currentUserId', body.data.user.id);",
                  "",
                  "if (body.data.mustChangePassword) {",
                  "  console.log('This account still holds a temporary password — run Change password next.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{seedEmail}}\",\n  \"password\": \"{{seedPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Email is normalised to lowercase server-side, so casing does not matter."
          }
        },
        {
          "name": "Login (Google)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Three legitimate outcomes, depending on how far Google is wired up:",
                  "//   400 — no googleIdToken set in the environment yet",
                  "//   503 — GOOGLE_CLIENT_ID missing from .env",
                  "//   200 — fully configured",
                  "if (pm.response.code === 400) {",
                  "  pm.test('skipped — set googleIdToken to exercise this', () => {",
                  "    pm.expect(pm.environment.get('googleIdToken') || '').to.eql('');",
                  "  });",
                  "} else if (pm.response.code === 503) {",
                  "  pm.test('reports Google is not configured', () => {",
                  "    pm.expect(pm.response.json().message).to.include('not configured');",
                  "  });",
                  "} else {",
                  "  pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refreshToken);",
                  "",
                  "  if (body.data.tempPasswordCleared) {",
                  "    console.log('Temporary password burned. The account is Google-only until it sets its own password.');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Rejects an unregistered email with 403 instead of creating an account — Google proves identity, it does not grant membership.\n\nReturns 503 while GOOGLE_CLIENT_ID is unset."
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no password hash', () => {",
                  "  pm.expect(pm.response.json().data.user).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns 401 once the account is deactivated, so sessions already in flight collapse on the next check."
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().data.accessToken;",
                  "pm.test('returns a new access token', () => pm.expect(token).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Change password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Normally you pick your own: put it in the `newPassword` environment",
                  "// variable and it is sent as-is.",
                  "//",
                  "// The generated fallback exists only so an unattended Newman run stays",
                  "// repeatable — the API rejects a new password identical to the current",
                  "// one, so a hardcoded value would fail on the second run.",
                  "const chosen = pm.environment.get('newPassword');",
                  "pm.collectionVariables.set('nextPassword', chosen || 'Sentinel' + Date.now());",
                  "",
                  "if (!chosen) {",
                  "  console.log('newPassword is empty — generated one instead. Set it to choose your own.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('clears mustChangePassword', () => {",
                  "  pm.expect(pm.response.json().data.user.mustChangePassword).to.eql(false);",
                  "});",
                  "",
                  "// Roll seedPassword forward so the collection stays runnable.",
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('seedPassword', pm.collectionVariables.get('nextPassword'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{seedPassword}}\",\n  \"newPassword\": \"{{nextPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "Set `newPassword` in the environment to choose your own. Leave it empty and the pre-request script generates one, purely so unattended runs stay repeatable — check the console for the value it used.\n\nEither way, `seedPassword` is rolled forward on success so the collection keeps working.\n\n`currentPassword` is always required — a pending password change never waives it. Minimum 8 characters, and it must differ from the current one. Returns 400 for a Google-only account; use Set password there."
          }
        },
        {
          "name": "Set password (Google-only account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 400 is the correct answer when the account already has a password.",
                  "if (pm.response.code === 400) {",
                  "  pm.test('refuses accounts that already have a password', () => {",
                  "    pm.expect(pm.response.json().message).to.include('already has a password');",
                  "  });",
                  "} else {",
                  "  pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"passwordSendiri123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/set-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "set-password"
              ]
            },
            "description": "First password for an account whose hash is NULL. Asks for no current password — the active session is the proof of ownership.\n\nAfterwards the account has two working ways in: password and Google."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Finance Lead only. These four endpoints are the ONLY place `isAdmin` is checked.",
      "item": [
        {
          "name": "List members",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const users = pm.response.json().data.users;",
                  "pm.test('every row carries a derived status', () => {",
                  "  users.forEach(u => pm.expect(['Pending', 'Active', 'Inactive']).to.include(u.status));",
                  "});",
                  "pm.test('no password hashes', () => {",
                  "  users.forEach(u => pm.expect(u).to.not.have.property('passwordHash'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "`status` is derived, not stored: never signed in → Pending, deactivated → Inactive, otherwise Active."
          }
        },
        {
          "name": "Create member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('returns the temporary password once', () => {",
                  "  pm.expect(body.data.tempPassword).to.be.a('string');",
                  "});",
                  "pm.test('starts as Pending', () => {",
                  "  pm.expect(body.data.user.status).to.eql('Pending');",
                  "});",
                  "pm.test('is not an admin', () => {",
                  "  pm.expect(body.data.user.isAdmin).to.eql(false);",
                  "});",
                  "",
                  "pm.collectionVariables.set('memberId', body.data.user.id);",
                  "pm.collectionVariables.set('memberEmail', body.data.user.email);",
                  "pm.collectionVariables.set('tempPassword', body.data.tempPassword);",
                  "",
                  "console.log('Temp password captured. No endpoint can read it back — use Reset password if it is lost.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@company.com\",\n  \"fullname\": \"Budi Staff\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Only email and full name — there is no role or department to pick.\n\nThe temporary password appears exactly once in this response. Duplicate email returns 409."
          }
        },
        {
          "name": "Reset member password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('issues a fresh temporary password', () => {",
                  "  pm.expect(body.data.tempPassword).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('tempPassword', body.data.tempPassword);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{memberId}}/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{memberId}}",
                "reset-password"
              ]
            },
            "description": "The only way out for someone who forgot their password, since the system sends no email.\n\nAlso works on a Google-only account, giving it a password route again."
          }
        },
        {
          "name": "Deactivate member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('now Inactive', () => {",
                  "  pm.expect(pm.response.json().data.user.status).to.eql('Inactive');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{memberId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{memberId}}",
                "status"
              ]
            },
            "description": "Never a hard delete — the account is referenced by `transactions.input_by_user_id`, and the audit trail has to survive."
          }
        },
        {
          "name": "Reactivate member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('active again', () => {",
                  "  pm.expect(pm.response.json().data.user.isActive).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{memberId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{memberId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Member signs in (arms the non-admin guard)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('member is not an admin', () => {",
                  "  pm.expect(body.data.user.isAdmin).to.eql(false);",
                  "});",
                  "pm.test('must change the temporary password', () => {",
                  "  pm.expect(body.data.mustChangePassword).to.eql(true);",
                  "});",
                  "",
                  "// Kept apart from accessToken so the admin session survives.",
                  "pm.environment.set('memberAccessToken', body.data.tokens.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{tempPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Signs in as the member created above using their temporary password, so Guards → non-admin is forbidden has a real non-admin token to work with.\n\nMust run after Reactivate member — a deactivated account cannot sign in."
          }
        }
      ]
    },
